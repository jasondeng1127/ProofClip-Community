{
  "name": "<YOUR_WORKER_NAME>",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-08-14",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<YOUR_D1_DATABASE_NAME>",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  "vars": {
    "PROOFCLIP_EXTENSION_ID": "<YOUR_EXTENSION_ID>"
  }
}
